{
  "schema": {
    "id_column": "request_id",
    "columns": {
      "request_id": {"type": "string"},
      "team": {"type": "string", "choices": ["ops", "sales"]},
      "severity": {"type": "string", "choices": ["high", "normal"]},
      "age_hours": {"type": "number", "min": "0"},
      "amount": {"type": "number", "required": false, "min": "0"}
    }
  },
  "rules": [
    {"id": "R1", "all": [{"column": "severity", "op": "eq", "value": "high"}, {"column": "age_hours", "op": "ge", "value": "24"}], "outcome": "critical", "priority": 0, "review": false, "source": "docs/operations.md:3"},
    {"id": "R2", "all": [{"column": "severity", "op": "eq", "value": "high"}], "outcome": "urgent", "priority": 1, "review": false, "source": "docs/operations.md:5"},
    {"id": "R3", "all": [{"column": "age_hours", "op": "ge", "value": "24"}], "outcome": "due", "priority": 2, "review": false, "source": "docs/operations.md:7"}
  ],
  "default": {"outcome": "routine", "priority": 3, "review": false, "source": "docs/operations.md:9"}
}
